-- ### 1. Objetivos de Aprendizagem | Learning Objectives  
-- - Compreender operadores de comparação e lógicos. | - Understand SQL comparison and logical operators.
-- - Aplicar condições avançadas de filtragem. | - Apply advanced filtering conditions.
-- - Pesquisar registros utilizando padrões e intervalos. | - Search records using patterns and ranges.
-- - Identificar valores NULL e não NULL. | - Identify NULL and non-NULL values.

-- ### 2. Operadores SQL |  SQL Operators
-- |    Operator    |     Description                     |   Descrição |
-- |      ---       |        ---                          |     ---           |
-- | AND            | Both conditions must be true        | Ambas as condições devem ser verdadeiras |
-- | OR             | At least one condition must be true | Pelo menos uma condição deve ser verdadeira |
-- | IN             | Matches values in a list            | Compara valores de uma lista |
-- | NOT IN         | Excludes values from a list         | Exclui valores de uma lista |
-- | BETWEEN        | Filters a range of values           | Filtra um intervalo de valores |
-- | LIKE           | Searches for a text pattern         | Pesquisa um padrão de texto |
-- | IS NULL        | Finds NULL values                   | Localiza valores nulos |
-- | IS NOT NULL    | Finds non-NULL values               | Localiza valores preenchidos |

-- ### 3. Practical Examples | Exemplos Práticos
-- Verificando se esta usando Banco de Dados correto. | Checking if the correct database is being used.
-- SQL
USE SQLRoadmapTrainingDB;
GO

-- AND: Ambas as condições devem ser verdadeiras. | AND: Both conditions must be true.
-- SQL
SELECT ProductName, Price, StockQuantity
FROM Products
WHERE Price > 300 AND StockQuantity > 10;
GO

-- OR: Pelo menos uma condição deve ser verdadeira. | OR: At least one condition must be true.
-- SQL
SELECT ProductName, Price
FROM Products
WHERE Price < 200
OR Price > 1000;
GO

-- IN: Pesquisar valores específicos. | IN: Search for specific values.
-- SQL
SELECT *
FROM Products
WHERE ProductName IN (
    'Notebook Dell',
    'Mouse Logitech'
);
GO

-- NOT IN: Excluir valores específicos. | NOT IN: Exclude specific values.
-- SQL
SELECT *
FROM Products
WHERE ProductName NOT IN (
    'Notebook Dell',
    'Mouse Logitech'
);
GO

-- BETWEEN: Filtrar produtos por intervalo de preço. |  BETWEEN: Filter products by price range.
-- SQL
SELECT ProductName, Price
FROM Products
WHERE Price BETWEEN 100 AND 1500;
GO

-- LIKE: Nomes iniciados com M. | LIKE: Names starting with M.
-- SQL
SELECT *
FROM Customers
WHERE FullName LIKE 'M%';
GO

-- Nomes contendo "Sil". | Names containing "Sil".
-- SQL
SELECT *
FROM Customers
WHERE FullName LIKE '%Sil%';
GO

-- IS NULL: Clientes sem telefone. | IS NULL: Customers without phone numbers
-- SQL
SELECT *
FROM Customers
WHERE Phone IS NULL;
GO

-- IS NOT NULL: Clientes com telefone. | IS NOT NULL: Customers with phone numbers.
-- SQL
SELECT *
FROM Customers
WHERE Phone IS NOT NULL;
GO


