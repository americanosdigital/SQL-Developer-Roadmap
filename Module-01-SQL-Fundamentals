-- ### 6. INNER JOIN
-- Consultar pedidos e informações dos clientes.
-- SQL
SELECT
    O.OrderId,
    C.FullName,
    O.OrderDate,
    O.OrderStatus
FROM Orders O
INNER JOIN Customers C
    ON O.CustomerId = C.CustomerId;
GO

-- ### 7. LEFT JOIN
-- Consultar todos os clientes, inclusive aqueles sem pedidos.
-- SQL
SELECT
    C.CustomerId,
    C.FullName,
    O.OrderId,
    O.OrderStatus
FROM Customers C
LEFT JOIN Orders O
    ON C.CustomerId = O.CustomerId;
GO


-- ### 8. RIGHT JOIN
-- Consultar todos os pedidos e seus clientes.
-- SQL
SELECT
    C.FullName,
    O.OrderId,
    O.OrderStatus
FROM Customers C
RIGHT JOIN Orders O
    ON C.CustomerId = O.CustomerId;
GO

-- ### 9. FULL OUTER JOIN
-- Consultar registros correspondentes e não correspondentes.
-- SQL
SELECT
    C.FullName,
    O.OrderId,
    O.OrderStatus
FROM Customers C
FULL OUTER JOIN Orders O
    ON C.CustomerId = O.CustomerId;
GO

-- ### 10. Insert Order Items
-- Inserir dois mouses Logitech em cada pedido concluído.
-- SQL
INSERT INTO OrderItems
    (OrderId, ProductId, Quantity, UnitPrice)
SELECT
    O.OrderId,
    P.ProductId,
    2,
    P.Price
FROM Orders O
INNER JOIN Products P
    ON P.ProductName = 'Mouse Logitech'
WHERE O.OrderStatus = 'Completed'
AND NOT EXISTS (
    SELECT 1
    FROM OrderItems OI
    WHERE OI.OrderId = O.OrderId
    AND OI.ProductId = P.ProductId
);
GO


-- ### 11. Relacionar Múltiplas Tabelas
-- Consultar detalhes dos pedidos.
-- SQL
SELECT
    O.OrderId,
    C.FullName,
    P.ProductName,
    OI.Quantity,
    OI.UnitPrice,
    OI.Quantity * OI.UnitPrice AS Total
FROM Orders O
INNER JOIN Customers C
    ON O.CustomerId = C.CustomerId
INNER JOIN OrderItems OI
    ON O.OrderId = OI.OrderId
INNER JOIN Products P
    ON OI.ProductId = P.ProductId;
GO

