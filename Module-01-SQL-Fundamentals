-- ### 6. NOT EXISTS
-- Encontrar clientes sem pedidos.
-- SQL
SELECT
    C.FullName,
    C.Email
FROM Customers C
WHERE NOT EXISTS (
    SELECT 1
    FROM Orders O
    WHERE O.CustomerId = C.CustomerId
);
