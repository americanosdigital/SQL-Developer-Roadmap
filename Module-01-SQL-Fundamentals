-- ### 9. FULL OUTER JOIN
-- Consultar registros correspondentes e não correspondentes. | Retrieve matching and non-matching records
-- SQL
SELECT
    C.FullName,
    O.OrderId,
    O.OrderStatus
FROM Customers C
FULL OUTER JOIN Orders O
    ON C.CustomerId = O.CustomerId;
GO

--### 10. Insert Order Items | Inserir Itens dos Pedidos
-- Inserir dois mouses Logitech em cada pedido concluído. | Insert two Logitech mice into each completed order
-- SQL
INSERT INTO OrderItems
    (OrderId, ProductId, Quantity, UnitPrice)
SELECT
    O.OrderId,
    P.ProductId,
    2,
    P.Price
FROM Orders O
INNER JOIN Products P
    ON P.ProductName = 'Mouse Logitech'
WHERE O.OrderStatus = 'Completed'
AND NOT EXISTS (
    SELECT 1
    FROM OrderItems OI
    WHERE OI.OrderId = O.OrderId
    AND OI.ProductId = P.ProductId
);
GO


-- ### 11. Relacionar Múltiplas Tabelas | ### 11. JOIN Multiple Tables
-- Consultar detalhes dos pedidos. | Retrieve order details
-- SQL
SELECT
    O.OrderId,
    C.FullName,
    P.ProductName,
    OI.Quantity,
    OI.UnitPrice,
    OI.Quantity * OI.UnitPrice AS Total
FROM Orders O
INNER JOIN Customers C
    ON O.CustomerId = C.CustomerId
INNER JOIN OrderItems OI
    ON O.OrderId = OI.OrderId
INNER JOIN Products P
    ON OI.ProductId = P.ProductId;
GO

