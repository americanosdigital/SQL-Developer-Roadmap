-- ### 3. Transação com ROLLBACK
-- SQL
BEGIN TRANSACTION;
UPDATE Products
SET StockQuantity = StockQuantity - 2
WHERE ProductName = 'Mouse Logitech'
AND StockQuantity >= 2;

SELECT *
FROM Products
WHERE ProductName = 'Mouse Logitech';

-- Desfazer alterações.
ROLLBACK TRANSACTION;
GO

-- ### 4. Transaction with COMMIT
-- ATENÇÃO: este exemplo confirma permanentemente +5 unidades no estoque do Mouse Logitech.
-- Execute somente se desejar manter essa alteração no banco.
-- SQL
BEGIN TRANSACTION;

UPDATE Products
SET StockQuantity = StockQuantity + 5
WHERE ProductName = 'Mouse Logitech';

COMMIT TRANSACTION;
GO

-- ### 5. TRY...CATCH
-- SQL
BEGIN TRY
	BEGIN TRANSACTION;
		UPDATE Products
        SET Price = Price
        WHERE ProductName = 'Mouse Logitech';
    IF @@ROWCOUNT = 0
        THROW 50001, 'Product not found.', 1;
    COMMIT TRANSACTION;
    PRINT 'Transaction completed successfully';
END TRY
BEGIN CATCH
    IF XACT_STATE() <> 0
        ROLLBACK TRANSACTION;
    SELECT
        ERROR_NUMBER() AS ErrorNumber,
        ERROR_MESSAGE() AS ErrorMessage;
END CATCH;
GO

