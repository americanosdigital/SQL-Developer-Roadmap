-- ### 2. Funções de Agregação. | ### 2. Aggregate Functions
-- | Function 	|		Descrição		|	Description |
-- |	---		|		  ---			|		---			|
-- | COUNT() 	| Conta registros		| Counts records  |
-- | SUM() 		| Calcula somatórios	| Calculates totals |
-- | AVG() 		| Calcula médias 		| Calculates averages |
-- | MIN() 		| Retorna o menor valor | Returns the minimum value |
-- | MAX() 		| Retorna o maior valor | Returns the maximum value |
-- | GROUP BY 	| Agrupa registros		| Groups records |
-- | HAVING 	| Filtra grupos         | Filters groups |

-- ### 3. Exemplos Práticos | ### 3. Practical Examples
-- Verificando se esta usando Banco de Dados correto. | Checking if the correct database is being used
-- SQL
USE SQLRoadmapTrainingDB;
GO

-- COUNT: Total de clientes. | COUNT: Total customers.
-- SQL
SELECT COUNT(*) AS TotalCustomers
FROM Customers;
GO

-- COUNT: Total de produtos. | COUNT: Total products.
-- SQL
SELECT COUNT(*) AS TotalProducts
FROM Products;
GO

-- SUM: Valor financeiro total do estoque. | SUM: Total inventory value.
-- SQL
SELECT SUM(Price * StockQuantity) AS TotalInventoryValue
FROM Products;
GO

-- AVG: Preço médio dos produtos. | AVG: Average product price.
-- SQL
SELECT AVG(Price) AS AveragePrice
FROM Products;
GO

-- MIN: Menor preço. | MIN: Lowest product price.
-- SQL
SELECT MIN(Price) AS LowestPrice
FROM Products;
GO

-- MAX: Maior preço. | MAX: Highest product price
-- SQL
SELECT MAX(Price) AS HighestPrice
FROM Products;
GO

-- GROUP BY: Agrupar produtos por status. | GROUP BY: Group products by status
-- SQL
SELECT
    IsActive,
    COUNT(*) AS TotalProducts
FROM Products
GROUP BY IsActive;
GO

-- HAVING: Filtrar resultados agrupados. | HAVING: Filter grouped results
-- SQL
SELECT
    IsActive,
    COUNT(*) AS TotalProducts
FROM Products
GROUP BY IsActive
HAVING COUNT(*) > 1;
GO

