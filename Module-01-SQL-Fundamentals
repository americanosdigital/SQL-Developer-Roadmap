-- ### 2. Criar View de Clientes e Pedidos.
-- SQL
CREATE OR ALTER VIEW dbo.vw_CustomerOrders
AS
SELECT
    C.CustomerId,
    C.FullName,
    C.Email,
    O.OrderId,
    O.OrderDate,
    O.OrderStatus
FROM Customers C
INNER JOIN Orders O
    ON C.CustomerId = O.CustomerId;
