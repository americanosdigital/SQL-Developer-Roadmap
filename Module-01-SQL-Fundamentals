-- ### 3. Criar Índice Não Clusterizado.
-- Criar índice para pesquisas por telefone
-- SQL
IF NOT EXISTS (
    SELECT 1
    FROM sys.indexes
    WHERE name = 'IX_Customers_Phone'
    AND object_id = OBJECT_ID('dbo.Customers')
)
BEGIN
    CREATE NONCLUSTERED INDEX IX_Customers_Phone
    ON Customers(Phone);
END;
GO

