-- ### 4. Create Product Inventory View
-- SQL
CREATE OR ALTER VIEW dbo.vw_ProductInventory
AS
SELECT
    ProductId,
    ProductName,
    Price,
    StockQuantity,
    Price * StockQuantity AS TotalInventoryValue
FROM Products;
GO

-- ### 5. Query Product Inventory
-- SQL
