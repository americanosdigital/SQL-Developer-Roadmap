-- ### 2. Create Customer Stored Procedure
-- SQL
USE SQLRoadmapTrainingDB;
GO

CREATE OR ALTER PROCEDURE dbo.usp_GetAllCustomers
AS
BEGIN
    SET NOCOUNT ON;
    SELECT
        CustomerId,
        FullName,
        Email,
        Phone
    FROM Customers;
END;
GO

-- ### 3. Executar Procedure
-- SQL
EXEC dbo.usp_GetAllCustomers;
GO

-- ### 4. Procedure com Parâmetros
-- SQL
CREATE OR ALTER PROCEDURE dbo.usp_GetCustomerByEmail
    @Email NVARCHAR(150)
AS
BEGIN
    SET NOCOUNT ON;
    SELECT
        CustomerId,
        FullName,
        Email,
        Phone
    FROM Customers
    WHERE Email = @Email;
END;
GO

-- Execute:
-- SQL
EXEC dbo.usp_GetCustomerByEmail
    @Email = 'joao@email.com';
GO

-- ### 5. Procedure de Produtos
-- SQL
CREATE OR ALTER PROCEDURE dbo.usp_GetProductsByPrice
    @MinimumPrice DECIMAL(10,2),
    @MaximumPrice DECIMAL(10,2)
AS
BEGIN
    SET NOCOUNT ON;
    SELECT
        ProductId,
        ProductName,
        Price,
        StockQuantity
    FROM Products
    WHERE Price BETWEEN @MinimumPrice AND @MaximumPrice
    ORDER BY Price ASC;
END;
GO

-- Execute:
-- SQL
EXEC dbo.usp_GetProductsByPrice
    @MinimumPrice = 100,
    @MaximumPrice = 2000;
GO

-- ### 6. Procedure com UPDATE.
-- SQL
CREATE OR ALTER PROCEDURE dbo.usp_UpdateProductPrice
    @ProductId INT,
    @NewPrice DECIMAL(10,2)
AS
BEGIN
    SET NOCOUNT ON;
    IF @NewPrice < 0
        THROW 50001, 'Price cannot be negative.', 1;
    UPDATE Products
    SET Price = @NewPrice
    WHERE ProductId = @ProductId;
    IF @@ROWCOUNT = 0
        THROW 50002, 'Product not found.', 1;
END;
GO

-- Execute somente após consultar o ProductId e decidir o novo preço.
-- Este exemplo altera dados permanentemente.
